# アプリケーション全般の設定
PORT=8080
ENV=development
LOG_LEVEL=debug
API_VERSION=v1
RUNNING_IN_DOCKER=false

# ================================
# データベース設定
# ================================

# 1. SQLiteを使用する場合（開発環境向け）
DB_DRIVER=sqlite
DB_DSN=app.db

# 2. PostgreSQLを使用する場合（本番環境向け）
# DB_DRIVER=postgres
# DB_DSN=postgresql://username:password@localhost:5432/dbname?sslmode=disable

# 後方互換性のためのDATABASE_URL（DB_DSNが優先されます）
# DATABASE_URL=postgresql://username:password@localhost:5432/dbname?sslmode=disable

# ================================
# セキュリティ
# ================================
SECRET=your-secret-key 