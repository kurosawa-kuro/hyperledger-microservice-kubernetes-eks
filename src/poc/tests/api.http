### ==================== 環境設定 ====================
@ecsHost = fullstack-03-alb-463226433.ap-northeast-1.elb.amazonaws.com
@localHost = localhost
@lightsailHost = 52.199.151.155

@port = 3000

### Base URLs
@ecsBaseUrl = http://{{ecsHost}}:{{port}}
@localBaseUrl = http://{{localHost}}:{{port}}
@lightsailBaseUrl = http://{{lightsailHost}}:{{port}}
@apiVersion = v1


### ==================== 基本ヘルスチェック ====================

### ルートパス (システムヘルスチェック)
GET {{localBaseUrl}}/
Accept: application/json

###
GET {{lightsailBaseUrl}}/
Accept: application/json

###
GET {{ecsBaseUrl}}/
Accept: application/json

### ヘルスチェック API エンドポイント
GET {{localBaseUrl}}/api/{{apiVersion}}/health
Accept: application/json

###
GET {{lightsailBaseUrl}}/api/{{apiVersion}}/health
Accept: application/json

###
GET {{ecsBaseUrl}}/api/{{apiVersion}}/health
Accept: application/json

### Hello エンドポイント (Express.js)
GET {{localBaseUrl}}/hello

### エラー発生エンドポイント
GET {{localBaseUrl}}/cause-error



###
GET {{lightsailBaseUrl}}/api/{{apiVersion}}/hello

###
GET {{ecsBaseUrl}}/api/{{apiVersion}}/hello

