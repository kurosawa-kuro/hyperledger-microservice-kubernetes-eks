### ==================== 環境設定 ====================
@ecsHost = fullstack-03-alb-463226433.ap-northeast-1.elb.amazonaws.com
@localHost = localhost
@lightsailHost = 52.199.151.155

@port = 3001

### Base URLs
@ecsBaseUrl = http://{{ecsHost}}:{{port}}
@localBaseUrl = http://{{localHost}}:{{port}}
@lightsailBaseUrl = http://{{lightsailHost}}:{{port}}


