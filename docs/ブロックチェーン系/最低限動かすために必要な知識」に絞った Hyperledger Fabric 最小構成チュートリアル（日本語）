## 1️⃣ ユーザー登録API（修正版 `/register`）

```js
const db = require('./db');
const bcrypt = require('bcrypt'); // パスワードをハッシュ化

app.post('/register', async (req, res) => {
  const { enrollId, password, affiliation = 'org1.department1' } = req.body;

  if (!enrollId || !password) {
    return res.status(400).json({ error: 'enrollId and password are required' });
  }

  try {
    // DBで重複チェック
    db.read();
    const existing = db.data.users.find(u => u.enrollId === enrollId);
    if (existing) {
      return res.status(400).json({ error: `User ${enrollId} already exists` });
    }

    // --- Fabric CA処理（CAクライアント初期化） ---
    const ccpPath = path.resolve(__dirname, 'connection-org1.json');
    const ccp = JSON.parse(fs.readFileSync(ccpPath, 'utf8'));
    const caInfo = ccp.certificateAuthorities['ca.org1.example.com'];
    const ca = new FabricCAServices(caInfo.url);
    const wallet = await Wallets.newFileSystemWallet(walletPath);

    const adminIdentity = await wallet.get('Org1Admin');
    if (!adminIdentity) throw new Error('Admin identity not found in wallet');
    const provider = wallet.getProviderRegistry().getProvider(adminIdentity.type);
    const adminUser = await provider.getUserContext(adminIdentity, 'Org1Admin');

    // CAに登録
    await ca.register({
      affiliation,
      enrollmentID: enrollId,
      enrollmentSecret: password, // 今回は password をそのまま secret として使う（CAの仕様上必要）
      role: 'client'
    }, adminUser);

    // enroll
    const enrollment = await ca.enroll({ enrollmentID: enrollId, enrollmentSecret: password });
    const identity = {
      credentials: {
        certificate: enrollment.certificate,
        privateKey: enrollment.key.toBytes()
      },
      mspId: 'Org1MSP',
      type: 'X.509'
    };
    await wallet.put(enrollId, identity);

    // DBにユーザー保存（ハッシュ化して保存）
    const hashedPassword = await bcrypt.hash(password, 10);
    db.data.users.push({ enrollId, password: hashedPassword });
    db.write();

    res.status(201).json({ message: `User ${enrollId} registered and enrolled` });

  } catch (err) {
    console.error('Register error:', err);
    res.status(500).json({ error: err.message });
  }
});
```

