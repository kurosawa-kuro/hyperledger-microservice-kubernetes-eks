## 2️⃣ ログインAPI `/login`

```js
const jwt = require('jsonwebtoken');
const SECRET_KEY = 'your-secret-key';

app.post('/login', async (req, res) => {
  const { enrollId, password } = req.body;

  db.read();
  const user = db.data.users.find(u => u.enrollId === enrollId);
  if (!user || !(await bcrypt.compare(password, user.password))) {
    return res.status(401).json({ error: 'Invalid credentials' });
  }

  const token = jwt.sign({ enrollId }, SECRET_KEY, { expiresIn: '2h' });
  res.json({ token });
});
```

---

## 3️⃣ ログアウトAPI（JWT無効化はフロントまたはブラックリスト管理で）

簡易的にはフロント側でトークンを破棄するだけです：

```js
app.post('/logout', (req, res) => {
  // JWTはステートレスなので実質何もしない
  res.status(200).json({ message: 'Logged out successfully' });
});
```

