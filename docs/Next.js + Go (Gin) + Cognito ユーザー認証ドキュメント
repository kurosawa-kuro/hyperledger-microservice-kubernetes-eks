### ✅ ログインエンドポイント（`/auth/login`）

```go
func loginHandler(c *gin.Context) {
	var req AuthRequest
	c.BindJSON(&req)

	secretHash := getSecretHash(req.Email, clientID, clientSecret)

	resp, err := cog.InitiateAuth(context.TODO(), &cognito.InitiateAuthInput{
		AuthFlow: "USER_PASSWORD_AUTH",
		ClientId: aws.String(clientID),
		AuthParameters: map[string]string{
			"USERNAME":    req.Email,
			"PASSWORD":    req.Password,
			"SECRET_HASH": secretHash,
		},
	})

	if err != nil {
		c.JSON(401, gin.H{"error": "ログイン失敗", "detail": err.Error()})
		return
	}

	idToken := *resp.AuthenticationResult.IdToken
	c.SetCookie("id_token", idToken, 3600, "/", "", false, true)
	c.JSON(200, gin.H{"message": "ログイン成功"})
}
```

---

### ✅ ログアウトエンドポイント（`/auth/logout`）

```go
func logoutHandler(c *gin.Context) {
	c.SetCookie("id_token", "", -1, "/", "", false, true)
	c.JSON(200, gin.H{"message": "ログアウトしました"})
}
```

